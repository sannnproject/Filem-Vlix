# ==============================================================================
# FilemVlix - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TMDB (The Movie Database) API Credentials (Optional)
# ------------------------------------------------------------------------------
# Get your FREE API Key or Read Access Token at: https://www.themoviedb.org/settings/api
# - If MEDIA_API_KEY is provided: FilemVlix loads the live catalog with millions of movies & shows.
# - If left empty: FilemVlix runs smoothly out-of-the-box using the Open Movie Demo Provider.
#
# Supports either:
#   a) TMDB API Key v3 (32 hex characters, e.g. 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d)
#   b) TMDB API Read Access Token v4 (JWT starting with eyJhbGciOi...)
MEDIA_API_KEY=

# (Alternative alias supported for TMDB Key)
# TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 2. Provider Mode ('tmdb' or 'demo')
# ------------------------------------------------------------------------------
# 'tmdb' : Uses The Movie Database API (requires MEDIA_API_KEY)
# 'demo' : Uses built-in Open Movie Demo catalog (4K/1080p open-source media)
MEDIA_API_PROVIDER=demo

# ------------------------------------------------------------------------------
# 3. TMDB Base API URL (Optional)
# ------------------------------------------------------------------------------
MEDIA_API_URL=https://api.themoviedb.org/3

# ------------------------------------------------------------------------------
# 4. Public Base Application URL (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
